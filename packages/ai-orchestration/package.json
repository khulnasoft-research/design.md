{
  "name": "@scalify/ai-orchestration",
  "version": "1.0.0",
  "description": "AI-powered prompt analysis and design-system generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./analyzer": {
      "types": "./dist/analyzer/index.d.ts",
      "import": "./dist/analyzer/index.js"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "import": "./dist/generation/index.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "import": "./dist/feedback/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "design-system",
    "ai",
    "prompt-analysis",
    "generation"
  ],
  "dependencies": {
    "@scalify/design-core": "*",
    "ai": "latest",
    "@ai-sdk/openai": "latest",
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/google": "latest"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
